# ==========================================
# codetwine Environment Variable Configuration
# Copy this file to .env and set each value
# Commented-out items use their default values
# Uncomment and modify values as needed
# ==========================================

# LLM API key (can be omitted for providers that don't require authentication, e.g. Ollama)
LLM_API_KEY=your-api-key-here

# API base URL (set when the endpoint differs from the default, e.g. Ollama, Azure OpenAI, self-hosted)
# If not set, litellm uses the default URL for each provider
#   Ollama:         http://localhost:11434
#   Azure OpenAI:   https://your-resource.openai.azure.com
# LLM_API_BASE=http://localhost:11434

# LLM model name used for summary and design document generation (required when ENABLE_LLM_DOC=True)
# Supports multiple providers via litellm. Specify the provider with a model name prefix.
#   Anthropic:  anthropic/<model>
#   OpenAI:     openai/<model>
#   Google:     gemini/<model>
#   Ollama:     ollama/<model>
#   Azure:      azure/<model>
LLM_MODEL=anthropic/claude-sonnet-4-6

# Root directory of the project to analyze (absolute path)
# Can also be specified via CLI argument --project-dir (overrides this value)
DEFAULT_PROJECT_DIR=/path/to/your/project_name

# Output directory for analysis results (default: output/ under repository root)
# Can also be specified via CLI argument --output-dir (overrides this value)
# When only --project-dir is specified, this value is ignored and the default is used
# DEFAULT_OUTPUT_DIR=/path/to/output

# Retry settings
MAX_RETRIES=3
RETRY_WAIT=2

# Number of parallel workers (default: 4)
MAX_WORKERS=4

# Number of files whose parse results are kept in memory at once (default: 200)
# 0 keeps every parse result until the run ends
# PARSE_CACHE_MAX_FILES=200

# Form of the whole-project analysis result (json / sqlite / both, default: json)
#   json   ... project_knowledge.json only
#   sqlite ... project_knowledge.sqlite only
#   both   ... both files
# The per-file JSON files are written in every case
# KNOWLEDGE_FORMAT=json

# Directory and file name patterns to exclude (comma-separated, fnmatch format,
# e.g. *.pyc, test_*, .venv)
# Every text file that is not excluded is collected and copied to the output: add secrets,
# data files, lock files and an output directory inside the project
# Default when not set: __pycache__,.git,.github,.venv,node_modules
# EXCLUDE_PATTERNS=__pycache__,.git,.github,.venv,node_modules

# Encodings tried, in order, on a source file that has no BOM and is not valid UTF-8
# (comma-separated Python codec names, default: none)
# The first one that decodes the file is used; list euc_jp before cp932
# A file that none of them decodes is decoded with a detected encoding
# SOURCE_ENCODING=euc_jp,cp932

# Path to design document template (default: doc_template.json under repository root)
# Path to a JSON file defining the document chapter structure and prompts
# DOC_TEMPLATE_PATH=/path/to/doc_template.json

# Token limit for LLM output (default: 16384)
# Maximum number of tokens in the LLM response when generating design documents
# DOC_MAX_TOKENS=16384

# Enable/disable LLM generation of design documents (True/False)
# When False, the entire design document step is skipped
ENABLE_LLM_DOC=True

# Maximum character count for summaries (default: 600)
# SUMMARY_MAX_CHARS=600

# Enable LLM summarization of large code when a design-document prompt exceeds
# the model context window (True/False, default: True)
# When False, an oversized prompt is only reduced by dropping context (the
# source code of callers and dependencies, the dependency summaries, the usage
# lists, the implementation file of a header), with no extra summarization LLM calls
# ENABLE_CODE_SUMMARY=True

# Line count above which a definition or dependency symbol is summarized (default: 40)
# A line longer than 80 characters counts as one line per 80 characters
# CODE_SUMMARY_TRIGGER_LINES=40

# Lines of source summarized together when a file still exceeds the context
# window after its large definitions are summarized (1 or more, default: 200)
# CODE_SUMMARY_PIECE_LINES=200

# Character limit for a single code behavior summary (default: 400)
# CODE_SUMMARY_MAX_CHARS=400

# LLM output language (default: English)
# Language used for summary and design document generation (e.g. Japanese, English, Chinese)
OUTPUT_LANGUAGE=English


